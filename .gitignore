# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 체크포인트와 데이터셋 — 용량이 커서 추적하지 않는다.
# E4가 만드는 체크포인트(checkpoints/e4_*.pt)는 이미 *.pt 규칙에 걸리지만,
# save_checkpoint가 원자적 교체 전에 쓰는 checkpoints/e4_*.tmp는 어느 확장자
# 규칙에도 걸리지 않는다 — 통짜로 막아 둔다.
checkpoints/
data/*
!data/__init__.py
!data/voc.py
!data/tiny_imagenet.py
data/tiny-imagenet-200/
data/tiny-imagenet-200.zip
*.pth
*.pt
*.safetensors

# 학습 로그
runs/
wandb/
*.log

# results/ 의 원시 측정값은 재현성을 위해 커밋한다.
# 다만 중간 산출 텐서 덤프는 제외한다.
results/**/*.npy
results/**/*.npz

# ERF map은 중간 덤프가 아니라 E2의 1차 측정값이다. 그림이 커밋된 데이터에서
# 나와야 한다는 원칙 때문에 이것만 예외로 추적한다(약 1.2MB).
!results/e2/erf_maps.npz

# OS / 에디터
.DS_Store
Thumbs.db
.idea/

# 테스트 출력 리다이렉트 잔재
test_output.txt
full_test_output.txt
*_test_output.txt
